# Los warnings/errores de PHP no deben imprimirse en la respuesta HTTP en
# produccion (se vio con extensiones/declaracion.php?dec_Id=<inexistente>:
# el usuario recibia rutas de servidor y trazas de PHP en pantalla en vez
# de un error controlado). Se siguen registrando en el log de Apache para
# poder depurar.
php_value display_errors Off
php_value log_errors On
php_value error_reporting E_ALL
